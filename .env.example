# Persistent app data root.
# In production, prefer an external directory such as /var/lib/careyou
APP_DATA_ROOT=storage

# Public base URL for invite links and external callbacks.
# In production, set this to your domain, for example:
# APP_BASE_URL=https://www.careyou.online
APP_BASE_URL=

# AI models are now read directly from configured provider chain.
# No active health-check tuning is required.

# File storage
# REPORT_STORAGE_MODE controls both source PDFs and analysis JSON files.
# Supported: local, oss.
REPORT_STORAGE_MODE=local
# Optional override for local file storage root. Defaults to APP_DATA_ROOT/local
# REPORT_LOCAL_STORAGE_ROOT=/var/lib/careyou/local
REPORT_UPLOAD_QUEUE_CONCURRENCY=1
REPORT_UPLOAD_QUEUE_CAP=20
REPORT_ANALYSIS_QUEUE_CONCURRENCY=2
REPORT_ANALYSIS_QUEUE_CAP=200
# Report analysis rate limits by user.
# Format: "<window>:<count>", comma-separated. Example: 1h:10,1d:40
# Supported window units: s, m, h, d, w
# Leave empty to disable.
REPORT_ANALYSIS_RATE_LIMITS=
# Comma-separated user IDs that bypass report analysis rate limits.
REPORT_ANALYSIS_RATE_LIMIT_WHITELIST_USER_IDS=
# Max manual retries allowed per failed report.
REPORT_ANALYSIS_MAX_RETRIES=2
# Reports list page size.
REPORT_LIST_PAGE_SIZE=10

# Application database
# Supported now: sqlite. Future adapters can support mysql/postgres.
DATABASE_DRIVER=sqlite
# Optional override. Defaults to APP_DATA_ROOT/data/app.sqlite
# SQLITE_DATABASE_PATH=/var/lib/careyou/data/app.sqlite

# Auth
# Use strong random secrets in production.
# AUTH_IDENTITY_ENCRYPTION_KEY can be a 32-byte base64 string, for example:
# openssl rand -base64 32
AUTH_JWT_SECRET=replace_with_a_long_random_secret
AUTH_IDENTITY_ENCRYPTION_KEY=replace_with_32_byte_base64_secret
AUTH_IDENTITY_HASH_SECRET=replace_with_a_long_random_secret
AUTH_LOGIN_CODE_SECRET=replace_with_a_long_random_secret
# In local development the request-code API returns devCode by default.
AUTH_DEV_RETURN_CODE=false
# Admin console email allowlist, comma-separated.
AUTH_ADMIN_EMAILS=

# Auth Channels (unified)
# Tencent Cloud shared credentials for SMS + Email
AUTH_TENCENT_SECRET_ID=
AUTH_TENCENT_SECRET_KEY=

# SMS login
# Supported providers: dev, tencent
AUTH_SMS_PROVIDER=dev
AUTH_SMS_TENCENT_REGION=ap-guangzhou
AUTH_SMS_TENCENT_ENDPOINT=sms.tencentcloudapi.com
AUTH_SMS_TENCENT_SDK_APP_ID=
AUTH_SMS_TENCENT_SIGN_NAME=
AUTH_SMS_TENCENT_TEMPLATE_ID=
# If your template is "{1} is your code, valid for {2} minutes", use: code,ttlMinutes
AUTH_SMS_TENCENT_TEMPLATE_PARAMS=code

# Email login
# Supported providers: dev, resend, tencent
AUTH_EMAIL_PROVIDER=dev
AUTH_EMAIL_FROM=知几 CareYou <noreply@careyou.online>
AUTH_EMAIL_RESEND_API_KEY=
AUTH_EMAIL_TENCENT_REGION=ap-guangzhou
AUTH_EMAIL_TENCENT_ENDPOINT=ses.tencentcloudapi.com
AUTH_EMAIL_TENCENT_TEMPLATE_ID=
AUTH_EMAIL_TENCENT_SUBJECT=【知几 CareYou】登录验证码
AUTH_EMAIL_TENCENT_REPLY_TO=
AUTH_EMAIL_TENCENT_TEMPLATE_PARAMS=code,ttlMinutes

# Optional override. Defaults to APP_DATA_ROOT/logs
# LOG_STORAGE_ROOT=/var/log/careyou

# WeChat OAuth login
# Website QR login requires a WeChat Open Platform website app.
AUTH_WECHAT_APP_ID=
AUTH_WECHAT_APP_SECRET=
AUTH_WECHAT_REDIRECT_URI=
AUTH_WECHAT_SCOPE=snsapi_login

# Compatibility notes
# The following old keys are still supported for now:
# SMS_PROVIDER, EMAIL_PROVIDER, EMAIL_FROM, RESEND_API_KEY
# TENCENTCLOUD_SECRET_ID, TENCENTCLOUD_SECRET_KEY
# TENCENT_SMS_*, TENCENT_EMAIL_*, WECHAT_OAUTH_*

# AI provider chain
# Put every AI provider setting in this single JSON array.
# The app tries providers from left to right.
# Supported providers: gemini, minimax, openai.
# Supported fields: provider, model, apiKey, baseUrl.
# MiniMax baseUrl: international https://api.minimax.io/anthropic, China https://api.minimaxi.com/anthropic.
# Keep this value on one line.
AI_PROVIDER_CHAIN=[{"provider":"gemini","model":"gemini-2.5-flash","apiKey":"your_gemini_api_key","baseUrl":""},{"provider":"minimax","model":"MiniMax-M2.7","apiKey":"your_minimax_api_key","baseUrl":"https://api.minimax.io/anthropic"},{"provider":"openai","model":"gpt-5.4-mini","apiKey":"your_openai_api_key","baseUrl":"https://api.openai.com/v1"}]
MINIMAX_MAX_TOKENS=20000

# Ali OSS
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_SECURE=true
OSS_BASE_PREFIX=health-reports

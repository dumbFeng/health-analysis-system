# File storage
# REPORT_STORAGE_MODE controls both source PDFs and analysis JSON files.
# Supported: local, oss.
REPORT_STORAGE_MODE=local
REPORT_UPLOAD_QUEUE_CONCURRENCY=1
REPORT_UPLOAD_QUEUE_CAP=20
REPORT_ANALYSIS_QUEUE_CONCURRENCY=2
REPORT_ANALYSIS_QUEUE_CAP=200

# Application database
# Supported now: sqlite. Future adapters can support mysql/postgres.
DATABASE_DRIVER=sqlite
SQLITE_DATABASE_PATH=storage/data/app.sqlite

# Auth
# Use strong random secrets in production. AUTH_IDENTITY_ENCRYPTION_KEY can be a
# 32-byte base64 string, for example: openssl rand -base64 32
AUTH_JWT_SECRET=replace_with_a_long_random_secret
AUTH_IDENTITY_ENCRYPTION_KEY=replace_with_32_byte_base64_secret
AUTH_IDENTITY_HASH_SECRET=replace_with_a_long_random_secret
AUTH_LOGIN_CODE_SECRET=replace_with_a_long_random_secret
# In local development the request-code API returns devCode by default.
AUTH_DEV_RETURN_CODE=false

# SMS
# Supported: dev, tencent. Use dev locally; use tencent in production.
SMS_PROVIDER=dev
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_ENDPOINT=sms.tencentcloudapi.com
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
# Template variable order. Common Tencent templates only need "code".
# If your template is like "{1} is your code, valid for {2} minutes", use: code,ttlMinutes
TENCENT_SMS_TEMPLATE_PARAMS=code

# Email login
# Supported: dev, resend, tencent. Use dev locally; use tencent/resend in production.
EMAIL_PROVIDER=dev
EMAIL_FROM=知几 CareYou <noreply@careyou.online>
RESEND_API_KEY=

# Tencent Cloud SES
TENCENT_EMAIL_REGION=ap-guangzhou
TENCENT_EMAIL_ENDPOINT=ses.tencentcloudapi.com
TENCENT_EMAIL_TEMPLATE_ID=
TENCENT_EMAIL_SUBJECT=【知几 CareYou】登录验证码
TENCENT_EMAIL_REPLY_TO=
# Template variable keys. Keep aligned with the Tencent Cloud template variables.
TENCENT_EMAIL_TEMPLATE_PARAMS=code,ttlMinutes

# WeChat OAuth login
# Website QR login requires a WeChat Open Platform website app.
WECHAT_OAUTH_APP_ID=
WECHAT_OAUTH_APP_SECRET=
WECHAT_OAUTH_REDIRECT_URI=
WECHAT_OAUTH_SCOPE=snsapi_login

# AI provider chain
# Put every AI provider setting in this single JSON array.
# The app tries providers from left to right.
# Supported providers: gemini, minimax, openai.
# Supported fields: provider, model, apiKey, baseUrl.
# MiniMax baseUrl: international https://api.minimax.io/anthropic, China https://api.minimaxi.com/anthropic.
# Keep this value on one line.
AI_PROVIDER_CHAIN=[{"provider":"gemini","model":"gemini-2.5-flash","apiKey":"your_gemini_api_key","baseUrl":""},{"provider":"minimax","model":"MiniMax-M2.7","apiKey":"your_minimax_api_key","baseUrl":"https://api.minimax.io/anthropic"},{"provider":"openai","model":"gpt-5.4-mini","apiKey":"your_openai_api_key","baseUrl":"https://api.openai.com/v1"}]
MINIMAX_MAX_TOKENS=20000

# Ali OSS
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_SECURE=true
OSS_BASE_PREFIX=health-reports
